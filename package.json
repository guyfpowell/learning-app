    "@expo/dom-webview": "~58.0.2",
    "@expo/vector-icons": "^15.1.1",
    "@learning/shared": "link:../learning/packages/shared",
    "@react-native-community/datetimepicker": "9.2.1",
    "@sentry/react-native": "^8.28.0",
    "@tanstack/react-query": "^5.101.2",
    "axios": "^1.18.1",
    "expo": "~58.0.19",
