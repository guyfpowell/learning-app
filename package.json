{
  "name": "learning-app",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --go",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "deploy:ota": "bash scripts/ota-deploy.sh",
    "deploy:ota:branch": "bash scripts/ota-deploy-branch.sh",
